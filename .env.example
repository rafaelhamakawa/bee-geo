# Chaves públicas de frontend. Nunca adicione chaves privadas ou service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Endpoint autenticado que consulta MapBiomas/Earth Engine. Opcional no modo manual.
VITE_GEO_ANALYSIS_URL=

# Deixe false em produção quando não quiser permitir o modo de demonstração.
VITE_ENABLE_DEMO_MODE=true
