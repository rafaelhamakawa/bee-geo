# Chaves públicas de frontend. Nunca adicione chaves privadas ou service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# URL pública da Edge Function; a chamada exige o JWT do usuário autenticado.
# Ex.: https://<PROJECT_REF>.supabase.co/functions/v1/analyze-pasture
VITE_GEO_ANALYSIS_URL=

# Deixe false em produção quando não quiser permitir o modo de demonstração.
VITE_ENABLE_DEMO_MODE=true
